{
  "name": "cyber-x-website",
  "version": "0.1.0",
  "description": "Cyber X: the website",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/db/test-db.mjs && playwright test",
    "e2e:iphone": "playwright test --project=iphone",
    "e2e:android": "playwright test --project=android",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:report": "playwright show-report",
    "check": "npm run check:shared && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:all": "npm run check && npm run e2e && npm run check:dev",
    "check:dev": "node scripts/dev-smoke.mjs",
    "sync:shared": "node scripts/shared/sync.mjs",
    "check:shared": "node scripts/shared/sync.mjs --check",
    "prebuild": "npm run check:shared"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "next": "16.4.6",
    "postgres": "3.4.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
